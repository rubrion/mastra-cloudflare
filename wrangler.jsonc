{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mastra-d1-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  // new_module_registry resolves module specifiers as URLs, which is what
  // makes `import.meta.url` real inside a Worker bundle. Mastra's server calls
  // `createRequire(import.meta.url)` while its workflow handlers initialise;
  // without this the Worker throws during module evaluation and never serves
  // a request. See https://blog.cloudflare.com/workers-module-registry-nodejs/
  //
  // `nodejs_compat` and `nodejs_compat_v2` are not listed: both are on by
  // default from compatibility date 2026-08-04. Nor is
  // `nodejs_compat_populate_process_env` — `process.env` auto-populates from
  // 2025-04-01, which is how the model router finds OPENAI_API_KEY.
  "compatibility_flags": ["new_module_registry"],
  "observability": { "enabled": true },
  "vars": {
    // Mastra model-router id. Override per-environment. Point OPENAI_BASE_URL
    // (a secret/var) at any OpenAI-compatible endpoint to use a custom model.
    "MODEL": "openai/gpt-4o-mini"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mastra-d1-agent",
      // Run `wrangler d1 create mastra-d1-agent` and paste the id here.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
