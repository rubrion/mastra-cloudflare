{
  "name": "@rubrion/mastra-cloudflare",
  "version": "0.2.1",
  "description": "Mastra agents on Cloudflare Workers: D1 memory, Workers AI and OpenAI-compatible models, and an OpenAI-compatible agent server with multi-agent routing.",
  "license": "GPL-3.0-only",
  "author": "Rubrion",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubrion/mastra-cloudflare.git"
  },
  "homepage": "https://github.com/rubrion/mastra-cloudflare#readme",
  "keywords": [
    "mastra",
    "cloudflare",
    "workers",
    "d1",
    "workers-ai",
    "agents",
    "openai-compatible"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.74",
    "@ai-sdk/provider": "^4.0.31",
    "@mastra/cloudflare-d1": "^1.4.3",
    "@mastra/core": "^1.78.0",
    "@mastra/memory": "^1.38.0",
    "@opentelemetry/api": "^1.9.1",
    "workers-ai-provider": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250918.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
